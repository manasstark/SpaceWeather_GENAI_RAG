# Copy to .env and fill in. Never commit .env.
# Embeddings run locally (decision 35); no key needed.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE=chroma
# Generator: a free local model through Ollama (decision 44). `ollama pull qwen2.5:7b-instruct` first.
# LLM_PROVIDER=baseline runs the offline generator with no model at all.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
# Not used by the current code; kept for a possible hosted provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
